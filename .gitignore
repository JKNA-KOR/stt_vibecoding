# Harness §9: .env 는 절대 커밋하지 않는다.
.env
.env.*
!.env.example

# Harness §8/§57: 음성 원본과 Transcript 는 Confidential 이므로 저장소에 들어가지 않는다.
/data/
# 모델 디렉터리 자체는 남기고 내용만 제외한다. compose 가 여기를 읽기 전용
# 마운트하므로 디렉터리가 없으면 도커가 root 소유로 만들어 버린다.
# (디렉터리를 통째로 제외하면 하위 파일을 다시 포함시킬 수 없다.)
/models/*
!/models/.gitkeep
*.wav
*.mp3
*.m4a
*.flac
*.ogg
*.webm
!tests/golden/assets/**/*.wav

# scripts/make_sample_audio.py 가 만드는 산출물. 스크립트가 결정론적이므로
# 파일을 커밋할 이유가 없다 (확장자 목록에 없는 거부 케이스까지 함께 제외한다).
/samples/

# Python
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# 로그는 stdout 으로 내보내는 것이 기본이나, 로컬 파일 출력 시에도 커밋하지 않는다.
*.log
/logs/

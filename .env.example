# =============================================================================
# STT Service 환경설정 예시 (Harness §9 / §63)
#
# 이 파일에는 더미 값만 둔다. 실제 Secret 은 절대 커밋하지 않는다.
#   cp .env.example .env  후 로컬 값으로 채운다. .env 는 .gitignore 대상이다.
# =============================================================================

# --- 환경 (Harness §34) ------------------------------------------------------
APP_ENV=local                       # local | dev | test | prod
APP_VERSION=1.0.0
GIT_COMMIT=unknown                  # 배포 시 CI 가 주입 (Harness §38)
LOG_LEVEL=INFO
DEBUG=false                         # Harness §35: prod 에서 true 이면 기동 실패시킨다

# --- 서버 --------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# 콤마 구분. 비워 두면 CORS 를 완전히 차단한다 (Harness §11 최소 CORS).
CORS_ALLOW_ORIGINS=

# --- 인증 / 세션 (Harness §10) -----------------------------------------------
AUTH_PROVIDER=local                 # local | oidc | ldap  (oidc/ldap 는 본 버전 미구현)
# 32바이트 이상 임의값. 생성: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME_dummy_session_secret_at_least_32_chars_long
SESSION_MAX_AGE_SECONDS=28800
SESSION_COOKIE_SECURE=false         # prod 에서는 반드시 true (HTTPS 전제)
LOGIN_MAX_FAILED_ATTEMPTS=5         # Harness §32
LOGIN_LOCK_SECONDS=900

# 초기 ADMIN 부트스트랩 전용. scripts/bootstrap_admin.py 실행 후 비워 둔다 (Harness §9).
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- 저장소 ------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://stt_app:CHANGE_ME_dummy_password@127.0.0.1:5432/stt
REDIS_URL=redis://127.0.0.1:6379/0
# celery | inline. inline 은 브로커 없이 호출 스레드에서 즉시 실행하므로 테스트·로컬 전용이며,
# prod 에서 선택하면 기동이 거부된다 (Harness §24).
QUEUE_BACKEND=celery
STORAGE_ROOT=./data                 # 음성/Transcript 저장 루트
TEMP_DIR=./data/tmp                 # Harness §22: 임시파일은 이 디렉터리에만 생성한다

# --- STT 엔진 (Harness §5.2) -------------------------------------------------
STT_ENGINE=faster-whisper           # faster-whisper | mock
STT_MODEL_NAME=medium
# 사전 반입한 모델 아티팩트 경로 (Harness §42). 비우면 STT_MODEL_NAME 으로 해석한다.
STT_MODEL_PATH=
STT_DEVICE=cpu                      # cpu | cuda
STT_COMPUTE_TYPE=int8               # cpu: int8 / cuda: float16 등
STT_LANGUAGE=ko                     # 비우면 자동 감지
STT_BEAM_SIZE=5
STT_VAD_ENABLED=true
STT_CPU_THREADS=4
# false 이면 모델이 로컬에 없을 때 기동을 실패시킨다 (Harness §42: 운영 중 동적 다운로드 지양).
STT_ALLOW_MODEL_DOWNLOAD=false

# --- 자원 보호 (Harness §24) -------------------------------------------------
STT_MAX_UPLOAD_MB=500
STT_MAX_AUDIO_MINUTES=180
STT_MAX_CONCURRENT_JOBS=2
STT_QUEUE_MAX_LENGTH=100
STT_JOB_TIMEOUT_SECONDS=3600
STT_MAX_RETRIES=2
API_RATE_LIMIT_PER_MINUTE=60        # Harness §11
UPLOAD_RATE_LIMIT_PER_MINUTE=10

# 콤마 구분 확장자 allowlist (Harness §6)
ALLOWED_AUDIO_EXTENSIONS=wav,mp3,m4a,flac,ogg,webm,mp4

# --- 보관 정책 (Harness §21) -------------------------------------------------
AUDIO_RETENTION_DAYS=30
TRANSCRIPT_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=1825
TEMP_FILE_MAX_AGE_HOURS=24

# --- Feature Flag (Harness §54) ----------------------------------------------
ENABLE_TRANSCRIPT_DOWNLOAD=true
ENABLE_AUDIO_DOWNLOAD=false         # 원본 음성 반출은 기본 차단 (Harness §43)
ENABLE_FFMPEG_PREPROCESS=false      # true 이면 ffmpeg 바이너리 필요
ENABLE_LLM_CORRECTION=false         # 본 버전 미구현 (Harness §2.1 분리 원칙)
ENABLE_DIARIZATION=false            # 본 버전 미구현

# ffmpeg 사용 시 실행 허용 바이너리 절대경로 (Harness §7 allowlist)
FFMPEG_BINARY=/usr/bin/ffmpeg
FFMPEG_TIMEOUT_SECONDS=600

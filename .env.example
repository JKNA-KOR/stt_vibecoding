# =============================================================================
# STT Service 환경설정 예시 (Harness §9 / §63)
#
# 이 파일에는 더미 값만 둔다. 실제 Secret 은 절대 커밋하지 않는다.
#   cp .env.example .env  후 로컬 값으로 채운다. .env 는 .gitignore 대상이다.
# =============================================================================

# --- 환경 (Harness §34) ------------------------------------------------------
APP_ENV=local                       # local | dev | test | prod
APP_VERSION=1.0.0
GIT_COMMIT=unknown                  # 배포 시 CI 가 주입 (Harness §38)
LOG_LEVEL=INFO
DEBUG=false                         # Harness §35: prod 에서 true 이면 기동 실패시킨다

# --- 서버 --------------------------------------------------------------------
HOST=127.0.0.1
PORT=8000
# 콤마 구분. 비워 두면 CORS 를 완전히 차단한다 (Harness §11 최소 CORS).
CORS_ALLOW_ORIGINS=

# --- 인증 / 세션 (Harness §10) -----------------------------------------------
AUTH_PROVIDER=local                 # local | oidc | ldap  (oidc/ldap 는 본 버전 미구현)
# 32바이트 이상 임의값. 생성: python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET=CHANGE_ME_dummy_session_secret_at_least_32_chars_long
SESSION_MAX_AGE_SECONDS=28800
SESSION_COOKIE_SECURE=false         # prod 에서는 반드시 true (HTTPS 전제)
# bcrypt 비용 계수. 하드웨어가 빨라지면 올린다. prod 하한은 12 이며 설정 검증이 강제한다.
BCRYPT_ROUNDS=12
LOGIN_MAX_FAILED_ATTEMPTS=5         # Harness §32
LOGIN_LOCK_SECONDS=900

# 초기 ADMIN 부트스트랩 전용. scripts/bootstrap_admin.py 실행 후 비워 둔다 (Harness §9).
BOOTSTRAP_ADMIN_USERNAME=
BOOTSTRAP_ADMIN_PASSWORD=

# --- 저장소 ------------------------------------------------------------------
DATABASE_URL=postgresql+psycopg://stt_app:CHANGE_ME_dummy_password@127.0.0.1:5432/stt
# 마이그레이션 전용 접속 (SEC-026). 런타임 계정은 DDL 권한을 갖지 않으므로 스키마
# 소유자 계정을 따로 쓴다. 비워 두면 DATABASE_URL 을 그대로 사용한다.
MIGRATION_DATABASE_URL=
REDIS_URL=redis://127.0.0.1:6379/0
# celery | inline. inline 은 브로커 없이 호출 스레드에서 즉시 실행하므로 테스트·로컬 전용이며,
# prod 에서 선택하면 기동이 거부된다 (Harness §24).
QUEUE_BACKEND=celery
STORAGE_ROOT=./data                 # 음성/Transcript 저장 루트
TEMP_DIR=./data/tmp                 # Harness §22: 임시파일은 이 디렉터리에만 생성한다

# --- STT 엔진 (Harness §5.2) -------------------------------------------------
STT_ENGINE=faster-whisper           # faster-whisper | groq-whisper | mock
STT_MODEL_NAME=medium
# 사전 반입한 모델 아티팩트 경로 (Harness §42). 비우면 STT_MODEL_NAME 으로 해석한다.
STT_MODEL_PATH=
STT_DEVICE=cpu                      # cpu | cuda
STT_COMPUTE_TYPE=int8               # cpu: int8 / cuda: float16 등
STT_LANGUAGE=ko                     # 비우면 자동 감지
STT_BEAM_SIZE=5
STT_VAD_ENABLED=true
STT_CPU_THREADS=4
# false 이면 모델이 로컬에 없을 때 기동을 실패시킨다 (Harness §42: 운영 중 동적 다운로드 지양).
STT_ALLOW_MODEL_DOWNLOAD=false

# --- 외부 전사 API (STT_ENGINE=groq-whisper 일 때만 쓰인다) --------------------
# 로컬 엔진과 달리 **음성 원본이 사내를 벗어난다.** 전사된 텍스트만 나가는 LLM 분석과는
# 위험의 크기가 다르므로 승인 플래그를 따로 둔다 (SEC-021).
#
# OpenAI 호환 전사 엔드포인트를 가리킨다. `/audio/transcriptions` 는 코드가 붙인다.
#   Groq   : https://api.groq.com/openai/v1   모델 whisper-large-v3 / whisper-large-v3-turbo
#   OpenAI : https://api.openai.com/v1        모델 whisper-1
STT_API_BASE_URL=https://api.groq.com/openai/v1
STT_API_KEY=
STT_API_TIMEOUT_SECONDS=600
# 엔드포인트가 받아 주는 파일 크기 상한(MB). 넘는 파일은 보내지 않고 즉시 거절한다.
# Groq 무료 25 / 유료 100, OpenAI 25 (2026-09 기준).
STT_API_MAX_UPLOAD_MB=25
# 음성 원본 외부 전송 명시 승인. false 이면 groq-whisper 선택 시 기동을 거부한다.
ALLOW_EXTERNAL_STT=false

# --- 자원 보호 (Harness §24) -------------------------------------------------
STT_MAX_UPLOAD_MB=500
STT_MAX_AUDIO_MINUTES=180
STT_MAX_CONCURRENT_JOBS=2
STT_QUEUE_MAX_LENGTH=100
STT_JOB_TIMEOUT_SECONDS=3600
STT_MAX_RETRIES=2
API_RATE_LIMIT_PER_MINUTE=60        # Harness §11
UPLOAD_RATE_LIMIT_PER_MINUTE=10

# 콤마 구분 확장자 allowlist (Harness §6)
ALLOWED_AUDIO_EXTENSIONS=wav,mp3,m4a,flac,ogg,webm,mp4

# --- 보관 정책 (Harness §21) -------------------------------------------------
AUDIO_RETENTION_DAYS=30
TRANSCRIPT_RETENTION_DAYS=365
AUDIT_RETENTION_DAYS=1825
TEMP_FILE_MAX_AGE_HOURS=24

# --- Feature Flag (Harness §54) ----------------------------------------------
ENABLE_TRANSCRIPT_DOWNLOAD=true
ENABLE_AUDIO_DOWNLOAD=false         # 원본 음성 반출은 기본 차단 (Harness §43)
ENABLE_FFMPEG_PREPROCESS=false      # true 이면 ffmpeg 바이너리 필요
ENABLE_LLM_CORRECTION=false         # 본 버전 미구현 (Harness §2.1 분리 원칙)
ENABLE_DIARIZATION=false            # 본 버전 미구현

# --- LLM 분석 (Harness §5.2 / §8.2 / §13) ------------------------------------
# 원본을 바꾸지 않고 요약·분류만 만든다. ENABLE_LLM_CORRECTION 과는 다른 기능이다.
# 접속 정보는 전부 여기서 온다 — 새 LLM 을 붙이는 데 코드 변경이 필요 없다.
ENABLE_LLM_ANALYSIS=false

# --- 상담 품질 평가 (QA) ---
# 상담 원칙과 컴플라이언스 기준으로 상담을 채점한다. 분석과 같은 LLM 설정을 쓰므로
# ENABLE_LLM_ANALYSIS=true 가 전제다. 켜면 상담당 LLM 호출이 2회로 늘어난다.
#
# 평가 기준(상담 원칙 / 금지 행위)은 코드에 기본값이 있고 관리 화면에서 덮어쓴다.
# 금융 상담 기준과 일반 고객센터 기준 두 벌이 기본 제공된다.
ENABLE_QA=false
# 전사가 끝나면 자동으로 평가한다. false 면 상담 상세의 버튼으로만 평가한다.
QA_AUTO_RUN=false

# --- 실시간 전사 (준실시간) ---
# 마이크 입력을 조각 단위로 잘라 전사한다. 진짜 스트리밍 ASR 이 아니므로 조각 경계에서
# 문맥이 끊긴다. 기록이 필요한 상담은 녹취 업로드를 쓴다.
#
# 켜면 이 출처에 브라우저 마이크 권한(Permissions-Policy)이 열린다. 꺼져 있으면
# microphone=() 로 잠겨 있어 화면 코드가 실수로 요청해도 브라우저가 막는다.
ENABLE_REALTIME_STT=false
# 조각 길이(초). 짧을수록 빨리 뜨지만 문맥이 자주 끊기고 호출 횟수가 늘어난다.
# 외부 STT API 를 쓰면 이 값이 곧 호출 빈도이자 비용이다.
REALTIME_SEGMENT_SECONDS=6
# 한 세션의 최대 길이(초). 잊고 켜 둔 탭이 자원을 계속 먹는 것을 막는다.
REALTIME_MAX_SESSION_SECONDS=1800
# 동시 세션 수 (API 프로세스당).
REALTIME_MAX_SESSIONS=4

# ollama            : Ollama 고유 API (/api/chat)
# openai-compatible : OpenAI 형식 /chat/completions 를 말하는 모든 엔드포인트
# openrouter        : OpenRouter 경유 (GLM 등 추론 모델의 응답 특성까지 함께 다룬다)
# mock              : 테스트용. prod 에서 선택하면 기동을 거부한다
LLM_PROVIDER=ollama

# 엔드포인트 주소. openai-compatible 은 보통 /v1 까지 포함한다.
LLM_BASE_URL=http://127.0.0.1:11434
LLM_MODEL_NAME=gemma3:latest

# 인증이 필요한 엔드포인트만 채운다. Bearer 토큰으로 전달되며 로그·응답에 남지 않는다.
LLM_API_KEY=

# 응답 형식 강제 방식. 엔드포인트가 지원하는 쪽을 고른다.
#   json_schema : 스키마를 그대로 강제 (지원하면 이쪽)
#   json_object : JSON 이라는 것만 강제 (구형 엔드포인트)
LLM_JSON_MODE=json_schema

LLM_TIMEOUT_SECONDS=300
LLM_MAX_TRANSCRIPT_CHARS=20000

# --- 추론 모델 대응 (LLM_PROVIDER=openrouter 일 때만 쓰인다) ---
# GLM 같은 추론 모델은 추론 토큰도 max_tokens 를 소비한다. 낮게 잡으면 본문이
# 비거나 잘려서 분석이 실패한다.
LLM_MAX_OUTPUT_TOKENS=32768
# 빈 값 = 모델 기본값. low | medium | high 로 추론 강도를 조절한다.
LLM_REASONING_EFFORT=
# OpenRouter 순위표 노출용 선택 헤더. 비워 두면 보내지 않는다.
LLM_APP_NAME=
LLM_SITE_URL=

# 녹취 본문을 외부 LLM 으로 보내는 것에 대한 명시 승인 (SEC-021).
# false 이면 LLM_BASE_URL 이 외부 주소일 때 기동을 거부한다.
# 켜기 전에 개인정보 영향평가와 위탁 계약이 선행되어야 한다.
ALLOW_EXTERNAL_LLM=false

# 설정 예시 (필요한 것만 골라 위 값을 덮어쓴다)
#
#  로컬 Ollama (기본)
#    LLM_PROVIDER=ollama
#    LLM_BASE_URL=http://127.0.0.1:11434
#    LLM_MODEL_NAME=gemma3:latest
#
#  사내 vLLM / LM Studio 등 OpenAI 호환 서버
#    LLM_PROVIDER=openai-compatible
#    LLM_BASE_URL=http://llm.internal:8000/v1
#    LLM_MODEL_NAME=Qwen2.5-14B-Instruct
#    LLM_API_KEY=사내발급키
#
#  외부 상용 API — 녹취가 사내를 벗어난다. 승인 절차 확인 후 사용한다.
#    LLM_PROVIDER=openai-compatible
#    LLM_BASE_URL=https://api.openai.com/v1
#    LLM_MODEL_NAME=gpt-4o-mini
#    LLM_API_KEY=발급키
#    ALLOW_EXTERNAL_LLM=true
#
#  OpenRouter 경유 GLM — 역시 녹취가 사내를 벗어난다 (SEC-021).
#    ENABLE_LLM_ANALYSIS=true
#    LLM_PROVIDER=openrouter
#    LLM_BASE_URL=https://openrouter.ai/api/v1
#    LLM_MODEL_NAME=z-ai/glm-5.2
#    LLM_API_KEY=sk-or-v1-...
#    LLM_JSON_MODE=json_schema      # GLM-5.2 는 스키마 강제를 지원한다
#    LLM_MAX_OUTPUT_TOKENS=32768
#    LLM_TIMEOUT_SECONDS=600
#    ALLOW_EXTERNAL_LLM=true

# ffmpeg 사용 시 실행 허용 바이너리 절대경로 (Harness §7 allowlist)
FFMPEG_BINARY=/usr/bin/ffmpeg
FFMPEG_TIMEOUT_SECONDS=600

# --- JSON 연동 (외부 시스템 통합) --------------------------------------------
# multipart 를 쓰기 어려운 클라이언트를 위한 경로다. 검증(확장자·시그니처·크기·
# 재생시간)은 multipart 와 같은 코드를 지난다 — 입구가 둘이어도 규칙은 하나다.

# POST /api/v1/jobs/json  으로 base64 음성을 받는다. 기본값은 꺼짐이다.
ENABLE_JSON_UPLOAD=false
# 디코딩된 원본 기준 상한. base64 는 약 33% 크므로 요청 본문 상한은 이보다 넉넉하다.
JSON_UPLOAD_MAX_MB=50
# 업로드를 제외한 일반 JSON 요청 본문 상한 (메모리 고갈 방지).
JSON_BODY_MAX_KB=512

# GET /api/v1/jobs/{id}/export  로 Job·Transcript·분석을 한 문서로 내보낸다.
ENABLE_JSON_EXPORT=true
# 내보내기 기본 구성. 요청 쿼리 파라미터로 덮어쓸 수 있다.
JSON_EXPORT_INCLUDE_TRANSCRIPT=true
JSON_EXPORT_INCLUDE_SEGMENTS=true
JSON_EXPORT_INCLUDE_ANALYSIS=true

# --- docker compose 전용 (Harness §34) ---------------------------------------
# 아래 값은 애플리케이션 설정이 아니라 compose 가 컨테이너를 만들 때 쓰는 값이다.
# compose 를 쓰지 않으면 무시해도 된다.

# 스키마 소유자 = 마이그레이션 실행 계정.
POSTGRES_USER=stt_owner
POSTGRES_PASSWORD=CHANGE_ME_dummy_owner_password
POSTGRES_DB=stt

# 애플리케이션 런타임 계정. DDL 권한이 없고 audit_event 에 INSERT 만 가능하다.
STT_APP_DB_USER=stt_app
STT_APP_DB_PASSWORD=CHANGE_ME_dummy_app_password

# 호스트에 노출할 포트. 127.0.0.1 로만 바인딩된다.
API_PORT=8000
DB_PORT=5433

# 사전 반입한 모델 디렉터리 (Harness §42). 컨테이너에 /models 로 읽기 전용 마운트된다.
STT_MODEL_DIR=./models
